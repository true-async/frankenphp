{
	admin off
	frankenphp {
		# keep defaults for num_threads/max_threads to let FrankenPHP size the pool automatically
	}
}

:8085 {
	root * .
	php_server {
		index off
		file_server off
		worker {
			file /home/edmond/frankenphp/async_entrypoint.php
			num 1
			async
			buffer_size 20
			match /*
		}
	}
}
